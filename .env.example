# Copy to .env for LOCAL development only. Never commit .env. Staging/production values
# come from the secret store (docs/STAGING.md), never from this file.
APP_ENV=development
APP_NAME=vip-shipping-gateway
DATABASE_URL=sqlite:///./vip_shipping.db
DB_CONNECT_TIMEOUT_SECONDS=5

# Viettel Post: DEVELOPMENT environment by default. Production must be set explicitly.
VTP_BASE_URL=https://partnerdev.viettelpost.vn
VTP_USERNAME=
VTP_PASSWORD=
VTP_TOKEN=
VTP_TIMEOUT_SECONDS=20
# Only after Viettel Post confirms the timezone of ORDER_STATUSDATE (D-006), e.g. Asia/Ho_Chi_Minh
VTP_WEBHOOK_TIMEZONE=

# Shared secret Viettel Post sends as body TOKEN on webhooks. Unset = webhook refuses (503).
WEBHOOK_SHARED_SECRET=
WEBHOOK_MAX_BODY_BYTES=65536

# API callers: "<key_id>:<sha256 hex>" entries, comma separated (python -m app.tools.api_key <id>).
# Unset = every /api/v1/shipping route except the webhook answers 503 (fail closed).
API_KEYS=
API_MAX_BODY_BYTES=262144

LOG_LEVEL=INFO
LOG_FORMAT=text
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY=0.2
PROVIDER_RETRY_MAX_DELAY=2.0
